<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LazyFabrics | Nordic Linen Fashion</title>
    <!-- 极简风格CSS -->
    <style>
        :root {
            --primary-color: #F3E9DE;  /* 亚麻米色 */
            --accent-color: #6B8E7F;    /* 森系绿色 */
        }

        * {
            box-sizing: border-box;
            margin: 0;
            font-family: 'Avenir', sans-serif;
        }

        /* 头部导航 */
        .navbar {
            padding: 1.5rem;
            border-bottom: 1px solid #ddd;
            position: sticky;
            top: 0;
            background: white;
        }
        .nav-links {
            display: flex;
            gap: 2rem;
            justify-content: center;
        }
        .nav-links a {
            text-decoration: none;
            color: var(--accent-color);
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        /* 英雄头图 */
        .hero {
            height: 80vh;
            background: linear-gradient(rgba(0,0,0,0.1), 
                       url('https://images.unsplash.com/photo-1529333166437-7750a6dd5a70') 
                       center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .hero-text {
            text-align: center;
            color: white;
        }
        .hero-text h1 {
            font-size: 3rem;
            margin-bottom: 1rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        /* 产品网格 */
        .products {
            padding: 4rem 2rem;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }
        .product-card {
            border: 1px solid #eee;
            padding: 1rem;
            transition: transform 0.3s;
        }
        .product-card:hover {
            transform: translateY(-5px);
        }
        .product-img {
            width: 100%;
            height: 400px;
            object-fit: cover;
        }
        .product-title {
            margin: 1rem 0;
            color: var(--accent-color);
        }

        /* 移动端优化 */
        @media (max-width: 768px) {
            .nav-links {
                flex-direction: column;
                align-items: center;
            }
            .hero-text h1 {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <!-- 导航 -->
    <nav class="navbar">
        <div class="nav-links">
            <a href="#collections">Collections</a>
            <a href="#about">About</a>
            <a href="#sustainability">Sustainability</a>
        </div>
    </nav>

    <!-- 头图 -->
    <section class="hero">
        <div class="hero-text">
            <h1>Nordic Linen Essentials</h1>
            <p>Breathable Fabrics, Timeless Designs</p>
        </div>
    </section>

    <!-- 产品列表 -->
    <main class="products" id="collections">
        <!-- 产品1 -->
        <article class="product-card">
            <img src="dress1.jpg" alt="Linen Wrap Dress" class="product-img">
            <h3 class="product-title">Wrap Dress</h3>
            <p>€89.00</p>
            <button class="add-to-cart">Add to Cart</button>
        </article>

        <!-- 产品2 -->
        <article class="product-card">
            <img src="dress2.jpg" alt="Linen Jumpsuit" class="product-img">
            <h3 class="product-title">Jumpsuit</h3>
            <p>€109.00</p>
            <button class="add-to-cart">Add to Cart</button>
        </article>
    </main>

